DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_LABEL=deepseek-v4-pro[1m]
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=5200
DRAFTOPS_CLIENT_PORT=3002
DEEPSEEK_AGENT_PORT=4318

# AWS Lambda agent API
MODEL_PROVIDER=deepseek
CHAT_MAX_TOKENS=1800
CORS_ALLOWED_ORIGINS=
DEEPSEEK_SECRET_ID=
DRAFTOPS_RAG_S3_BUCKET=
DRAFTOPS_RAG_S3_KEYS=public-data/expanded_import_bundle.json,public-data/agent_expanded_recommended_board.json,public-data/agent_balanced_board.json,data/final/milestone_answers.json,data/normalized/normalized_china_nba_draft_board_20260623.json,public-data/prospect_media.json
DRAFTOPS_RAG_DYNAMODB_TABLES=
DRAFTOPS_RAG_DYNAMODB_LIMIT=160
DRAFTOPS_RAG_CACHE_TTL_MS=300000
DRAFTOPS_RAG_EMBEDDING_PROVIDER=local
DRAFTOPS_RAG_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
DRAFTOPS_RAG_BEDROCK_EMBEDDING_MAX_CHARS=6000
DRAFTOPS_RAG_DASHSCOPE_SECRET_ID=
DRAFTOPS_RAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DRAFTOPS_RAG_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DRAFTOPS_RAG_DASHSCOPE_EMBEDDING_MAX_CHARS=6000
DRAFTOPS_RAG_DASHSCOPE_BATCH_SIZE=10
DRAFTOPS_RAG_EMBEDDING_DIMENSIONS=1024
DRAFTOPS_RAG_RERANK_POOL=36
DRAFTOPS_RAG_TOP_K=12
